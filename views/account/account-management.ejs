<div class="account-management-container">
  <% if (title) { %>
    <h1><%= title %></h1>
  <% } %>

  <%# Display flash messages %>
  <%- messages() %>

  <%# Display validation errors %>
  <% if (errors) { %>
    <ul class="notice">
      <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
      <%  }) %>
    </ul>
  <% } %>

  <div class="account-content">
    <% if (locals.loggedin) { %>
      <div class="welcome-section">
        <h2>Welcome <%= accountData.account_firstname %>!</h2>
        <p class="account-info">You're logged in as: <strong><%= accountData.account_type %></strong></p>
      </div>

      <div class="account-actions">
        <h3>Account Options</h3>
        <ul class="action-list">
          <li>
            <a href="/account/update/<%= accountData.account_id %>" class="action-link">
              Update Account Information
            </a>
          </li>
        </ul>
      </div>

      <% if (accountData.account_type == 'Employee' || accountData.account_type == 'Admin') { %>
        <div class="inventory-management-section">
          <h3>Inventory Management</h3>
          <p>
            <a href="/inv" class="action-link">
              Manage Inventory
            </a>
          </p>
        </div>
      <% } %>

    <% } else { %>
      <p>Please <a href="/account/login">log in</a> to access your account.</p>
    <% } %>
  </div>
</div>