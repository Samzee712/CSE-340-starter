<div class="admin-reviews-container">
  <h1><%= title %></h1>
  
  <%- messages() %>
  
  <div class="admin-header">
    <p>Review and approve customer reviews before they appear publicly.</p>
  </div>

  <% if (pendingReviews && pendingReviews.length > 0) { %>
    <div class="pending-count">
      <span class="badge"><%= pendingReviews.length %></span> review(s) pending
    </div>

    <div class="reviews-list">
      <% pendingReviews.forEach(review => { %>
        <div class="review-card pending">
          <div class="review-header">
            <div class="vehicle-info">
              <h3><%= review.inv_year %> <%= review.inv_make %> <%= review.inv_model %></h3>
              <div class="reviewer-info">
                <span>By: <%= review.account_firstname %> <%= review.account_lastname %></span>
                <span class="review-date"><%= new Date(review.review_date).toLocaleDateString() %></span>
              </div>
            </div>
            <div class="rating-display">
              <div class="stars">
                <% for(let i = 1; i <= 5; i++) { %>
                  <span class="star <%= i <= review.review_rating ? 'filled' : '' %>">★</span>
                <% } %>
              </div>
              <span class="rating-text"><%= review.review_rating %>/5</span>
            </div>
          </div>
          
          <div class="review-content">
            <p><%= review.review_text %></p>
          </div>
          
          <div class="review-actions">
            <a href="/review/approve/<%= review.review_id %>" class="btn btn-success">✓ Approve</a>
            <a href="/review/admin-delete/<%= review.review_id %>" 
               class="btn btn-danger" 
               onclick="return confirm('Delete this review?')">✗ Delete</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="no-pending">
      <p>No reviews pending approval.</p>
      <p>✓ All caught up!</p>
    </div>
  <% } %>

  <div class="back-link">
    <a href="/inv">← Back to Inventory</a>
  </div>
</div>
