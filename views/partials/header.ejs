<header id="top-header">
  <div class="header-container">
    <div class="siteName">
      <a href="/" title="Return to home page">CSE Motors</a>
    </div>
    <div id="tools">
      <% if (locals.loggedin) { %>
        <a title="Click to manage account" href="/account/">
          Welcome <%= accountData.account_firstname %>
        </a>
        <a title="Click to logout" href="/account/logout">Logout</a>
      <% } else { %>
        <a title="Click to log in" href="/account/login">My Account</a>
      <% } %>
    </div>
  </div>
</header>