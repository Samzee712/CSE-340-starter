<div class="form-container">
  <% if (title) { %>
    <h1><%= title %></h1>
  <% } %>

  <%# Display flash messages %>
  <%- messages() %>

  <%# Display validation errors %>
  <% if (errors) { %>
    <ul class="notice">
      <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
      <%  }) %>
    </ul>
  <% } %>

  <form id="updateForm" class="add-inventory-form" action="/inv/update" method="post">
    
    <div class="form-row">
      <div class="form-group">
        <label for="classification_id">Classification:</label>
        <%- classificationSelect %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="inv_make">Make:</label>
        <input 
          type="text" 
          id="inv_make" 
          name="inv_make" 
          required 
          placeholder="Enter make"
          value="<%= inv_make %>"
        >
      </div>

      <div class="form-group">
        <label for="inv_model">Model:</label>
        <input 
          type="text" 
          id="inv_model" 
          name="inv_model" 
          required 
          placeholder="Enter model"
          value="<%= inv_model %>"
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="inv_year">Year:</label>
        <input 
          type="text" 
          id="inv_year" 
          name="inv_year" 
          required 
          pattern="^\d{4}$"
          placeholder="YYYY"
          value="<%= inv_year %>"
        >
      </div>

      <div class="form-group">
        <label for="inv_price">Price:</label>
        <input 
          type="number" 
          id="inv_price" 
          name="inv_price" 
          required 
          step="0.01"
          min="0"
          placeholder="0.00"
          value="<%= inv_price %>"
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="inv_miles">Mileage:</label>
        <input 
          type="number" 
          id="inv_miles" 
          name="inv_miles" 
          required 
          min="0"
          placeholder="Enter mileage"
          value="<%= inv_miles %>"
        >
      </div>

      <div class="form-group">
        <label for="inv_color">Color:</label>
        <input 
          type="text" 
          id="inv_color" 
          name="inv_color" 
          required 
          placeholder="Enter color"
          value="<%= inv_color %>"
        >
      </div>
    </div>

    <div class="form-group">
      <label for="inv_description">Description:</label>
      <textarea 
        id="inv_description" 
        name="inv_description" 
        required 
        rows="4"
        placeholder="Enter vehicle description"
      ><%= inv_description %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="inv_image">Image Path:</label>
        <input 
          type="text" 
          id="inv_image" 
          name="inv_image" 
          required 
          placeholder="/images/vehicles/no-image.png"
          value="<%= inv_image %>"
        >
      </div>

      <div class="form-group">
        <label for="inv_thumbnail">Thumbnail Path:</label>
        <input 
          type="text" 
          id="inv_thumbnail" 
          name="inv_thumbnail" 
          required 
          placeholder="/images/vehicles/no-image-tn.png"
          value="<%= inv_thumbnail %>"
        >
      </div>
    </div>

    <!-- Hidden field to pass inv_id -->
    <input type="hidden" name="inv_id" value="<%= inv_id %>">

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" disabled>Update Vehicle</button>
      <a href="/inv" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
  <script src="/js/inv-update.js"></script>
</div>